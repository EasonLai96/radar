 "write:2d964375:claude:https://github.com/OpenMOSS/MOSS-Image": {
  "v": {
   "title": "MOSS-Image 開源生圖模型",
   "summary": "OpenMOSS 公開 5B 參數 DiT 生圖模型 MOSS-Image，程式碼與權重都已釋出，支援文字渲染、版面控制與 4K token 長提示詞。",
   "why": "可在 ComfyUI 安裝外掛試跑，也能照指南用 LoRA 微調出自己的畫風。"
  },
  "at": "2026-10-19T01:29:09.851Z"
 },
 "write:2d964375:claude:https://api-docs.deepseek.com/guides/search": {
  "v": {
   "title": "DeepSeek 推出搜尋與抓取功能",
   "summary": "DeepSeek 的 API 文件列出 search 與 fetch 功能，每 1000 次成功請求收費 $0.75。",
   "why": "做 Discord 機器人時，可以評估讓 AI 查網頁、抓內容要花多少錢。"
  },
  "at": "2026-10-19T01:29:11.115Z"
 },
 "write:2d964375:claude:https://simonwillison.net/2026/Oct/17/document-currentscript": {
  "v": {
   "title": "script 標籤能在原地替換自己",
   "summary": "行內 script 用 currentScript.replaceWith 載入時替換自己，再包成 $() 就像簡易模板語言。",
   "why": "做網頁小遊戲時，不用框架也能在頁面直接塞入年份或玩家名稱等動態文字。"
  },
  "at": "2026-10-19T01:29:13.580Z"
 },
 "write:2d964375:claude:https://github.com/Noniv/web-ocean": {
  "v": {
   "title": "不用引擎的 WebGPU 海洋渲染",
   "summary": "web-ocean 是不用引擎、從零寫的 WebGPU 海洋渲染器，有 FFT 波浪與日落天空，Chrome 開單一 HTML 檔就能跑。",
   "why": "想做網頁 3D 或學 WebGPU，可以直接讀它的原始碼，看波浪和天空怎麼寫。"
  },
  "at": "2026-10-19T01:29:14.454Z"
 },
 "write:2d964375:claude:https://github.com/datalab-to/indra": {
  "v": {
   "title": "Indra：CPU 上的極速 OCR",
   "summary": "約 1M 參數的 Indra OCR 在 CPU 上每秒可讀 49 頁，能輸出 markdown、純文字或帶框的 JSON。",
   "why": "Discord 機器人想辨識圖片或 PDF 文字，不用 GPU 也能跑。"
  },
  "at": "2026-10-19T01:29:21.651Z"
 },
 "write:2d964375:claude:https://github.com/jtydhr88/ComfyArt": {
  "v": {
   "title": "ComfyArt：完全本機執行的開源 AI 設計畫布",
   "summary": "ComfyArt 是開源的 AI 設計畫布，跑在你自己的 ComfyUI 上，圖像、影片、音訊、3D 都在本機生成，不需帳號或點數。內建設計 Agent，可匯出 PNG、PDF、PPTX。",
   "why": "已經在用 ComfyUI 的人，可以直接拿它當海報或遊戲美術的免費設計工作台。"
  },
  "at": "2026-10-19T01:29:32.975Z"
